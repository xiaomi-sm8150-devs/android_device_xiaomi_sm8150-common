# Allow access to keyboard sysfs
allow hal_lineage_accessories_default sysfs_keyboard:dir r_dir_perms;
allow hal_lineage_accessories_default sysfs_keyboard:file rw_file_perms;

# Allow access to touchpanel sysfs
allow hal_lineage_accessories_default sysfs_touchpanel:dir r_dir_perms;
allow hal_lineage_accessories_default sysfs_touchpanel:file rw_file_perms;

# Allow access to USB devices
allow hal_lineage_accessories_default usb_device:dir r_dir_perms;
allow hal_lineage_accessories_default usb_device:{file chr_file} rw_file_perms;

# /sys/bus/usb/devices access
allow hal_lineage_accessories_default sysfs:dir r_dir_perms;
allow hal_lineage_accessories_default sysfs:file rw_file_perms;
